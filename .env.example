# ServicePi Environment Configuration
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control - it may contain sensitive data

# ============================================================================
# Docker Compose Configuration
# ============================================================================

# Project name for Docker Compose (used as prefix for containers)
COMPOSE_PROJECT_NAME=servicepi

# ============================================================================
# Timezone Configuration
# ============================================================================

# Set your timezone (used by Home Assistant, Pi-hole, and other services)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# ============================================================================
# Network Configuration
# ============================================================================

# Your Raspberry Pi's IP address (optional, used by Pi-hole)
# Leave empty for auto-detection
PI_IP=

# ============================================================================
# Pi-hole Configuration
# ============================================================================

# Pi-hole web interface password
# IMPORTANT: Change this to a strong password!
# Default is 'servicepi' - DO NOT use in production
PIHOLE_PASSWORD=servicepi

# Upstream DNS servers (comma-separated)
# Default: Cloudflare DNS (1.1.1.1, 1.0.0.1)
# Alternatives:
#   - Google DNS: 8.8.8.8;8.8.4.4
#   - Quad9: 9.9.9.9;149.112.112.112
#   - OpenDNS: 208.67.222.222;208.67.220.220
PIHOLE_DNS=1.1.1.1;1.0.0.1

# ============================================================================
# IoT Service Configuration
# ============================================================================

# IoT API service port (internal)
# Default: 8080 (proxied through nginx)
API_PORT=8080

# Admin token for system update functionality
# IMPORTANT: Set a strong random token for production!
# Generate with: openssl rand -hex 32
# This token is required to trigger system updates via the dashboard
ADMIN_TOKEN=

# CORS allowed origins (comma-separated)
# Default: localhost only
# For production, add your Pi's hostname: http://raspberrypi.local,http://192.168.1.100
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# ============================================================================
# Home Assistant Configuration
# ============================================================================

# Home Assistant is configured through its web interface on first run
# Additional configuration can be placed in configs/homeassistant/configuration.yaml

# ============================================================================
# Portainer Configuration
# ============================================================================

# Portainer is configured through its web interface on first run
# No environment variables needed

# ============================================================================
# Security Notes
# ============================================================================

# 1. NEVER commit this file to version control if it contains real passwords
# 2. Use strong passwords (12+ characters, mixed case, numbers, symbols)
# 3. Rotate credentials regularly
# 4. For production, consider using Docker Secrets or a secrets manager
# 5. Keep this file readable only by root and the servicepi user:
#    sudo chown servicepi:servicepi .env
#    sudo chmod 600 .env

# ============================================================================
# Optional: Docker Configuration
# ============================================================================

# If you need to pass additional Docker Compose options, add them here
# COMPOSE_FILE=docker-compose.yml
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_PROJECT_NAME=servicepi

# ============================================================================
# Optional: Resource Limits
# ============================================================================

# Uncomment and customize if you want to limit container resources
# Format: number[unit] where unit can be b, k, m, g

# PIHOLE_MEMORY_LIMIT=512m
# PORTAINER_MEMORY_LIMIT=256m
# HOMEASSISTANT_MEMORY_LIMIT=1g
# IOT_MEMORY_LIMIT=256m

# ============================================================================
# Optional Services Configuration
# ============================================================================

# Enable/disable optional services
# Note: These flags are for documentation purposes. WordPress is enabled by default
# in docker-compose.yml. To disable WordPress, comment out the wordpress services.
# To enable Wazuh, you must also uncomment Wazuh services in docker-compose.yml
# (Docker Compose doesn't support conditional service inclusion without profiles)
ENABLE_WORDPRESS=true
ENABLE_WAZUH=false

# ============================================================================
# OpenWebUI Configuration
# ============================================================================

# OpenWebUI is a web interface for Large Language Models (LLMs)
# It connects to an Ollama instance to provide LLM capabilities

# Ollama Base URL - The internal server address where Ollama is running
# Default: http://host.docker.internal:11434 (assumes Ollama running on host)
# Examples:
#   - For Ollama on host machine: http://host.docker.internal:11434
#   - For Ollama on another Pi: http://192.168.1.100:11434
#   - For Ollama in another container: http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenWebUI Secret Key (optional but recommended)
# Used for session encryption and security
# Generate with: openssl rand -hex 32
# Leave empty to auto-generate (will change on container restart)
OPENWEBUI_SECRET_KEY=

# ============================================================================
# WordPress Configuration
# ============================================================================

# WordPress database configuration
# ⚠️ SECURITY CRITICAL: You MUST change these passwords before deploying!
# DO NOT use these example passwords in production!
# Generate secure passwords with: openssl rand -hex 32
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=CHANGEME_INSECURE_DEFAULT
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_ROOT_PASSWORD=CHANGEME_INSECURE_DEFAULT
WORDPRESS_TABLE_PREFIX=wp_

# ============================================================================
# Wazuh Configuration
# ============================================================================

# ⚠️ WARNING: Wazuh requires significant resources (4GB+ RAM, 8GB recommended)
# Only enable if your Raspberry Pi has sufficient memory
# Set ENABLE_WAZUH=true above to enable these services
# Note: This flag is for documentation purposes - you must also manually uncomment 
# Wazuh services in docker-compose.yml as Docker Compose doesn't support 
# conditional service inclusion without profiles.

# ⚠️ SECURITY CRITICAL: You MUST change these passwords before deploying!
# DO NOT use these example passwords in production!
# Generate secure passwords with: openssl rand -hex 32

# Wazuh Indexer (OpenSearch) credentials
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=CHANGEME_INSECURE_DEFAULT

# Wazuh API credentials for dashboard access
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=CHANGEME_INSECURE_DEFAULT

# ============================================================================
# Optional: Custom Configuration
# ============================================================================

# Add any custom environment variables your services need here
# They will be available to all Docker Compose services

# Example: Custom API key for a service
# MY_SERVICE_API_KEY=your-api-key-here

# Example: Custom domain name
# MY_DOMAIN=servicepi.local
